{
  "title": "Fronius Modbus",
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Set up Fronius System",
        "description": "Enter the host, choose the local Web API access role, and set the update intervals and Modbus IP restriction. Minimum interval: 5 seconds. The technician role additionally enables the export limit control. Without the web API, the SoC mode, SoC maximum, backup reserve, grid charging permission, Solar API, export limit and Modbus reset are not available, and Modbus TCP has to be switched on in the inverter beforehand. Switching an existing entry to it removes those entities; their history stays.",
        "data": {
          "host": "Host",
          "scan_interval": "Update interval (seconds)",
          "web_scan_interval": "Web API update interval (seconds)",
          "modbus_restriction": "Modbus IP restriction",
          "api_username": "Web API access role"
        }
      },
      "user_password": {
        "title": "Web API password",
        "description": "Enter the password of the selected Web API role for {entry_title} ({host}) to create or refresh the stored token. The password is not stored in the config entry.",
        "data": {
          "api_password": "Password"
        }
      },
      "reconfigure": {
        "title": "Review Fronius System",
        "description": "Review the host, the local Web API access role, the update intervals and the Modbus IP restriction. Minimum interval: 5 seconds. The technician role additionally enables the export limit control. Without the web API, the SoC mode, SoC maximum, backup reserve, grid charging permission, Solar API, export limit and Modbus reset are not available, and Modbus TCP has to be switched on in the inverter beforehand. Switching an existing entry to it removes those entities; their history stays.",
        "data": {
          "host": "Host",
          "scan_interval": "Update interval (seconds)",
          "web_scan_interval": "Web API update interval (seconds)",
          "modbus_restriction": "Modbus IP restriction",
          "api_username": "Web API access role"
        }
      },
      "reconfigure_password": {
        "title": "Web API password",
        "description": "Enter the password of the selected Web API role for {entry_title} ({host}) to create or refresh the stored token. The password is not stored in the config entry.",
        "data": {
          "api_password": "Password"
        }
      },
      "reauth_confirm": {
        "title": "Log in to the Fronius Web API again",
        "description": "The stored login of this entry is missing or was rejected, for example after the password was changed on the inverter. Choose the access role; the next step asks for its password. If you do not want to use the web API, choose Without the web API. Without the web API, the SoC mode, SoC maximum, backup reserve, grid charging permission, Solar API, export limit and Modbus reset are not available, and Modbus TCP has to be switched on in the inverter beforehand. Switching an existing entry to it removes those entities; their history stays.",
        "data": {
          "api_username": "Web API access role"
        }
      },
      "reauth_password": {
        "title": "Web API password",
        "description": "Enter the password of the selected Web API role for {entry_title} ({host}) to create or refresh the stored token. The password is not stored in the config entry.",
        "data": {
          "api_password": "Password"
        }
      }
    },
